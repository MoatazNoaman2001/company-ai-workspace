# Company AI Workspace: environment file
# Copy to /opt/company-ai/.env on the server (scripts/bootstrap-env.sh does this and
# generates every __HEXn__ secret). The real .env never goes into git.
# Names verified against LibreChat v0.8.8 .env.example.

# ---------------------------------------------------------------------------
# Deployment (read by docker compose)
# ---------------------------------------------------------------------------
# IP the published ports bind to. On the VPS: its Tailscale IP. Never 0.0.0.0.
BIND_IP=127.0.0.1
# Host port for LibreChat (container port 3080).
LIBRECHAT_PORT=3480
# Host port for the LibreChat Admin Panel (container port 3000; 3000 is taken on the VPS).
ADMIN_PANEL_PORT=3481

# ---------------------------------------------------------------------------
# Public URLs (the HTTPS name served by `tailscale serve`)
# ---------------------------------------------------------------------------
DOMAIN_CLIENT=https://your-host.your-tailnet.ts.net:8443
DOMAIN_SERVER=https://your-host.your-tailnet.ts.net:8443
# Admin Panel URL, used for admin SSO redirects. No trailing slash.
ADMIN_PANEL_URL=https://your-host.your-tailnet.ts.net:8444
# Do not let search engines index the instance.
NO_INDEX=true
# Number of reverse proxies in front of LibreChat (tailscale serve = 1).
TRUST_PROXY=1
# We run exactly one LibreChat replica (no Redis), so the scheduler may arm.
SCHEDULES_SINGLE_PROCESS=true

# ---------------------------------------------------------------------------
# Secrets (generated by scripts/bootstrap-env.sh; never reuse between environments)
# ---------------------------------------------------------------------------
# Encrypts stored credentials in MongoDB. 32 bytes / 16 bytes hex.
CREDS_KEY=__HEX32__
CREDS_IV=__HEX16__
# Sign LibreChat session and refresh tokens.
JWT_SECRET=__HEX32__
JWT_REFRESH_SECRET=__HEX32__
# Meilisearch master key (chat search).
MEILI_MASTER_KEY=__HEX32__
# Admin Panel session secret (32+ chars). The panel refuses to start without it.
ADMIN_PANEL_SESSION_SECRET=__HEX32__
# Session secret for the OpenID login flow.
OPENID_SESSION_SECRET=__HEX32__
# Shared secret LibreChat sends to our MCP servers; they reject calls without it (FR-17).
MCP_SERVICE_SECRET=__HEX32__

# ---------------------------------------------------------------------------
# Vector database (pgvector, used by the RAG API)
# ---------------------------------------------------------------------------
POSTGRES_DB=librechat_vectors
POSTGRES_USER=librechat
POSTGRES_PASSWORD=__HEX24__

# ---------------------------------------------------------------------------
# Sign-in (FR-01): SSO only. No local passwords in production.
# First boot only: set ALLOW_EMAIL_LOGIN=true, create the admin, switch it to SSO (RUNBOOK), set back to false.
# ---------------------------------------------------------------------------
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
# New SSO users get an account on first sign-in; allowedDomains + IdP limit who that can be.
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
# Short LibreChat sessions (FR-02): 15 minutes, refresh token 7 days.
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7
# Shared links only inside the instance.
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

# --- Microsoft Entra ID (OpenID Connect). Fill in when the app registration exists.
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0/
OPENID_ISSUER=
OPENID_SCOPE=openid profile email offline_access
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Sign in with Microsoft
OPENID_USE_END_SESSION_ENDPOINT=true
# Use Entra refresh tokens for sessions; re-check with Entra every 15 min (FR-02).
OPENID_REUSE_TOKENS=true
OPENID_REUSE_MAX_SESSION_AGE_MS=900000
# Only members of these Entra groups/roles may sign in (comma-separated).
OPENID_REQUIRED_ROLE=
OPENID_REQUIRED_ROLE_TOKEN_KIND=id
OPENID_REQUIRED_ROLE_PARAMETER_PATH=roles
# Entra group/role that grants LibreChat ADMIN.
OPENID_ADMIN_ROLE=
OPENID_ADMIN_ROLE_PARAMETER_PATH=roles
OPENID_ADMIN_ROLE_TOKEN_KIND=id
# Map Entra roles to LibreChat roles (one role per user, by priority) (FR-02).
OPENID_ROLE_SYNC_ENABLED=false
OPENID_ROLE_SYNC_API_ENABLED=false
OPENID_ROLE_SYNC_SOURCE=id
OPENID_ROLE_SYNC_CLAIM=roles
# Highest first, e.g. POWER_USER,APPROVER,STAFF
OPENID_ROLE_SYNC_ROLE_PRIORITY=
OPENID_ROLE_SYNC_FALLBACK_ROLE=

# --- Google sign-in. Fill in when the Google Cloud OAuth client exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/oauth/google/callback

# ---------------------------------------------------------------------------
# Models (FR-03). Keys stay on the server and are never sent to the browser.
# ---------------------------------------------------------------------------
ENDPOINTS=anthropic,openAI,google,agents
ANTHROPIC_API_KEY=
# Approved Anthropic models.
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
OPENAI_API_KEY=
# Approved OpenAI models (comma-separated). Empty = LibreChat's default list.
OPENAI_MODELS=
# Groq (free tier, OpenAI-compatible). Models are listed in librechat.yaml.
GROQ_API_KEY=
# Google Gemini (AI Studio key, free tier). Free-tier prompts may be used by Google: demo data only.
GOOGLE_KEY=
# Approved Gemini models (free tier verified 2026-11-17; Pro models are paid-only).
GOOGLE_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# File search / RAG (FR-06)
# ---------------------------------------------------------------------------
# Gemini embeddings (free tier); the RAG API reads GOOGLE_KEY. Alternative: openai / text-embedding-3-small.
EMBEDDINGS_PROVIDER=google_genai
EMBEDDINGS_MODEL=gemini-embedding-001
# Only for EMBEDDINGS_PROVIDER=openai. Empty = the RAG API uses OPENAI_API_KEY.
RAG_OPENAI_API_KEY=
